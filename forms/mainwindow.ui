<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>800</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>MainWindow</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
   /* Estilo general de la ventana y paneles */
    QMainWindow, QWidget#centralwidget {
        background-color: #FCECC0;
        color: #000000;
    }

    /* Barra de menús */
    QMenuBar {
        background-color: #FCECC0;
        color: #000000;
    }
    QMenuBar::item:selected {
        background-color: #673AB7;
        color: #FFFFFF;
    }

	/* QLAbels*/
	QLabel{
		 background-color: #FCECC0;
        color: #000000;
	}

    /* Barra de estado con fondo crema unificado */
    QStatusBar {
        background-color: #FCECC0;
        color: #673AB7;
    }
	
	/* QToolBar*/
	QToolBar{
		background-color:#FCECC0;
		color:#673AB7;
	}

	QToolBar:separator{
		background-color:#FCECC0;
	}

/* Estado Hover: Efecto simulado de hundido (Sunken) al pasar el ratón */
QToolBar QToolButton:hover {
    background-color: #FCECC0; /* Un gris más oscuro que el fondo para dar profundidad */
    border-top: 1px solid #999999;     /* Sombra interna superior */
    border-left: 1px solid #999999;    /* Sombra interna izquierda */
    border-bottom: 1px solid #ffffff;  /* Brillo inferior */
    border-right: 1px solid #ffffff;   /* Brillo derecho */
}

/* Estado Pressed: Hundido real y más profundo al hacer clic */
QToolBar QToolButton:pressed, QToolBar QToolButton:checked {
    background-color: #b0b0b0; /* Aún más oscuro */
    border-top: 2px solid #666666;
    border-left: 2px solid #666666;
    border-bottom: 1px solid #e0e0e0;
    border-right: 1px solid #e0e0e0;
    padding-top: 5px;  /* Desplaza ligeramente el texto/icono hacia abajo */
    padding-left: 5px; /* Desplaza ligeramente hacia la derecha para simular presión */
}

    /* Estilo genérico para botones que añadas en el futuro */
    QPushButton {
        background-color: #F63D03;
        color: #FFFFFF;
    }
    QPushButton:hover {
        background-color: #673AB7;
    }
    QPushButton:pressed {
    	background-color: #000000;
    }

	QProgressBar {
       background-color: #FCECC0;      /* Color de Fondo Crema */
   		border: 1px solid #673AB7;       /* Color Secundario */
       text-align: center;  							 /* Centra el porcentaje */    
       font-weight: bold;
       color: #000000;              					/* Texto del % en negro */
   }
   QProgressBar::chunk {
       background-color: #F63D03;      /* Color Primario Naranja */
   }</string>
  </property>
